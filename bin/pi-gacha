#!/usr/bin/env bash
#
# pi-gacha — launch the pi-gacha coding-agent harness: the vendored pi CLI with
# the pi-gacha extension loaded. Everything after the flags is passed straight
# through to pi (an initial prompt, extra flags, or nothing for interactive).
#
# Model, provider, and credentials are pi's own concern — pi-gacha assumes
# nothing. Pick a model with `--model provider/id` (or the interactive /model
# picker; pi remembers your default) and provide the key the way pi expects
# (an env var like DEEPSEEK_API_KEY, `--api-key`, or `/login`). See the README's
# "Model / provider" section.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PI_CLI="$ROOT/vendor/pi/packages/coding-agent/dist/cli.js"
EXT="$ROOT/packages/pi-gacha/extensions/index.ts"

if [[ ! -f "$PI_CLI" ]]; then
	echo "pi-gacha: vendored pi is not built." >&2
	echo "  run: ./setup.sh   (or: pnpm pi:build)" >&2
	exit 1
fi

exec node "$PI_CLI" --extension "$EXT" "$@"
